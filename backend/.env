# Copy this file to .env and fill in real values

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database - SQLite by default, swap for Postgres/MySQL in production
# Postgres example: postgresql://user:password@localhost:5432/skillsense
# MySQL example:    mysql+pymysql://user:password@localhost:3306/skillsense
DATABASE_URL=sqlite:///./skillsense.db

# AI Layer (optional) - if not set, the app falls back to rule-based
# question generation and scoring so the platform still works end-to-end.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
